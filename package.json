{
  "name": "capi",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "capi": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "smoke:qwen": "bun run scripts/smoke-qwen.ts",
    "smoke:texto": "bun run scripts/smoke-texto-continuidad.ts",
    "smoke:deepseek": "bun run scripts/smoke-qwen.ts deepseek",
    "coverage": "rm -rf coverage && bun test --coverage --coverage-reporter=lcov && bun run scripts/verificar-cobertura.ts",
    "verify": "bun run typecheck && bun test && bun run coverage",
    "mcp": "bun run src/mcp.ts",
    "agent:discover": "bun run src/cli.ts discover --output json",
    "smoke:mcp": "bun run scripts/smoke-mcp.ts",
    "smoke:archivo:qwen": "bun run scripts/smoke-archivo.ts qwen",
    "smoke:archivo:deepseek": "bun run scripts/smoke-archivo.ts deepseek",
    "smoke:imagen:qwen": "bun run scripts/smoke-imagen.ts qwen",
    "contracts:check": "bun run scripts/verificar-contratos.ts",
    "state:metrics": "bun run src/cli.ts estado metricas --output json",
    "smoke:recuperacion": "bun run scripts/smoke-recuperacion.ts",
    "smoke:qwen:background": "bun run scripts/smoke-durable-proveedor.ts qwen background",
    "smoke:qwen:recuperacion": "bun run scripts/smoke-durable-proveedor.ts qwen kill",
    "smoke:qwen:pestana": "bun run scripts/smoke-durable-proveedor.ts qwen pestana",
    "smoke:qwen:cancelacion": "bun run scripts/smoke-durable-proveedor.ts qwen cancelacion",
    "smoke:deepseek:background": "bun run scripts/smoke-durable-proveedor.ts deepseek background",
    "smoke:deepseek:recuperacion": "bun run scripts/smoke-durable-proveedor.ts deepseek kill",
    "smoke:deepseek:pestana": "bun run scripts/smoke-durable-proveedor.ts deepseek pestana",
    "smoke:deepseek:cancelacion": "bun run scripts/smoke-durable-proveedor.ts deepseek cancelacion",
    "smoke:chatgpt:background": "bun run scripts/smoke-durable-proveedor.ts chatgpt background",
    "smoke:chatgpt:recuperacion": "bun run scripts/smoke-durable-proveedor.ts chatgpt kill",
    "smoke:chatgpt:pestana": "bun run scripts/smoke-durable-proveedor.ts chatgpt pestana",
    "smoke:chatgpt:cancelacion": "bun run scripts/smoke-durable-proveedor.ts chatgpt cancelacion"
  }
}
