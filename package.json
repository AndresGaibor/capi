{
  "name": "capi",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "jsdom": "^29.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "capi": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "smoke:qwen": "bun run scripts/smoke-qwen.ts",
    "smoke:deepseek": "bun run src/cli.ts chat enviar --proveedor deepseek --modelo default --nueva \"Responde solamente con la palabra OK\"",
    "coverage": "rm -rf coverage && bun test --coverage --coverage-reporter=lcov && bun run scripts/verificar-cobertura.ts",
    "verify": "bun run typecheck && bun test && bun run coverage",
    "mcp": "bun run src/mcp.ts",
    "agent:discover": "bun run src/cli.ts discover --output json",
    "smoke:mcp": "bun run scripts/smoke-mcp.ts",
    "smoke:archivo:qwen": "bun run scripts/smoke-archivo.ts qwen",
    "smoke:archivo:deepseek": "bun run scripts/smoke-archivo.ts deepseek"
  }
}
